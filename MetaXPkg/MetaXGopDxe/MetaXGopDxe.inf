[Defines]
    INF_VERSION                     = 0x00010005
    BASE_NAME                       = MetaXGopDxe
    FILE_GUID                       = 12345678-1234-1234-1234-123456789abc
    MODULE_TYPE                     = UEFI_DRIVER
    VERSION_STRING                  = 1.0
    ENTRY_POINT                     = MetaXGopDxeEntryPoint
    PCI_VENDOR_ID                   = 0xAAAA
    PCI_DEVICE_ID                   = 0xBBBB
    PCI_CLASS_CODE                  = 0x000380
    PCI_COMPRESS                    = FALSE
    PCI_ROM                         = TRUE

[Sources]
    ComponentName.c
    driver.c
    gop.c
    Initialize.c
    MetaXGpu.h

[Packages]
    MdePkg/MdePkg.dec
    MdeModulePkg/MdeModulePkg.dec
    MetaXPkg/MetaXPkg.dec

[LibraryClasses]
    UefiDriverEntryPoint
    UefiBootServicesTableLib
    UefiLib
    BaseMemoryLib
    MemoryAllocationLib
    FrameBufferBltLib
    DebugLib
    DxeServicesTableLib

[Protocols]
    gEfiGraphicsOutputProtocolGuid
    gEfiPciIoProtocolGuid
    gEfiDriverBindingProtocolGuid