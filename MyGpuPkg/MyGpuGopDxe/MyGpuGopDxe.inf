    MdeModulePkg/MdeModulePkg.dec
    MyGpuPkg/MyGpuPkg.dec

[LibraryClasses]
    UefiDriverEntryPoint
    UefiBootServicesTableLib
    UefiLib
    BaseMemoryLib
    MemoryAllocationLib
    DebugLib

[Protocols]
    gEfiGraphicsOutputProtocolGuid
    gEfiPciIoProtocolGuid
    gEfiDriverBindingProtocolGuid